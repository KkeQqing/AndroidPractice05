<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidPractice05">
        <!-- 1. 主入口：MainActivity -->
        <!-- 注意：这里不要动，保持原样 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboard"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- 2. 第二入口：CarouselActivity -->
        <!-- 关键点：必须单独定义，且 label 必须不同 -->
        <activity
            android:name=".CarouselActivity"
            android:exported="true"
            android:label="@string/carousel_app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AndroidPractice05">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HandlerThreadActivity"
            android:exported="true"
            android:label="Handler 练习"
            android:launchMode="singleTask"
            android:taskAffinity="com.example.androidpractice05.handler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>