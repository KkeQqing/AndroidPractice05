<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".HandlerThreadActivity">

    <!-- 1. 显示图片的 ImageView -->
    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:scaleType="fitCenter"
        android:background="#CCCCCC"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="展示图片" />

    <!-- 2. 按钮 1：UI 主线程加载 -->
    <Button
        android:id="@+id/btn_ui_thread"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="展示图片 (UI 主线程)"
        android:layout_marginTop="24dp"
        android:onClick="showImageByUiThread"
        app:layout_constraintTop_toBottomOf="@id/iv_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. 按钮 2：子线程加载 -->
    <Button
        android:id="@+id/bt_thread"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="展示图片 (子线程)"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_ui_thread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>